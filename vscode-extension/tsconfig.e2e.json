{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020"],
    "rootDir": "test/e2e",
    "outDir": "test/e2e",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false,
    "types": ["mocha", "node"]
  },
  "include": [
    "test/e2e/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
