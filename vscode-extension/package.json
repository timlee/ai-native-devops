{
  "name": "ai-native-devops",
  "displayName": "AI-Native DevOps",
  "description": "Guide software development through the 11-phase AI-native DevOps lifecycle using Claude, Codex, or GitHub Copilot APIs",
  "version": "0.1.9",
  "publisher": "ai-native-devops",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/timlee/ai-native-devops.git"
  },
  "homepage": "https://github.com/timlee/ai-native-devops",
  "bugs": {
    "url": "https://github.com/timlee/ai-native-devops/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "ai",
    "devops",
    "lifecycle",
    "claude",
    "codex",
    "copilot",
    "planning",
    "checklist"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiNativeDevOps",
          "title": "AI-Native DevOps",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "aiNativeDevOps": [
        {
          "id": "aiNativeDevOps.lifecycle",
          "name": "Lifecycle Phases",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "aiNativeDevOps.openPhase",
        "title": "Open Phase Guide",
        "category": "AI DevOps"
      },
      {
        "command": "aiNativeDevOps.runPrompt",
        "title": "Run AI Prompt for Phase",
        "category": "AI DevOps"
      },
      {
        "command": "aiNativeDevOps.openChecklist",
        "title": "Open Phase Checklist",
        "category": "AI DevOps"
      },
      {
        "command": "aiNativeDevOps.openDashboard",
        "title": "Open AI DevOps Dashboard",
        "category": "AI DevOps"
      },
      {
        "command": "aiNativeDevOps.selectProvider",
        "title": "Select AI Provider",
        "category": "AI DevOps"
      },
      {
        "command": "aiNativeDevOps.runCustomPrompt",
        "title": "Run Custom Prompt",
        "category": "AI DevOps"
      },
      {
        "command": "aiNativeDevOps.runAgentAutomation",
        "title": "Run Agent Automation Flow",
        "category": "AI DevOps"
      },
      {
        "command": "aiNativeDevOps.scaffoldAgentArtifacts",
        "title": "Scaffold Agent Artifacts",
        "category": "AI DevOps"
      },
      {
        "command": "aiNativeDevOps.processWebhookQueue",
        "title": "Process Webhook Queue",
        "category": "AI DevOps"
      },
      {
        "command": "aiNativeDevOps.generateCodePrTemplate",
        "title": "Generate CODE Agent PR Draft",
        "category": "AI DevOps"
      },
      {
        "command": "aiNativeDevOps.scaffoldGithubWebhookWorkflows",
        "title": "Scaffold GitHub Webhook Workflows",
        "category": "AI DevOps"
      }
    ],
    "configuration": {
      "title": "AI-Native DevOps",
      "properties": {
        "aiNativeDevOps.provider": {
          "type": "string",
          "enum": [
            "claude",
            "openai",
            "copilot"
          ],
          "enumDescriptions": [
            "Anthropic Claude (claude-3-5-sonnet-20241022)",
            "OpenAI (GPT-4o / Codex)",
            "GitHub Copilot (uses VS Code Copilot Chat API)"
          ],
          "default": "copilot",
          "description": "AI provider to use for generating code and guidance"
        },
        "aiNativeDevOps.anthropicApiKey": {
          "type": "string",
          "default": "",
          "description": "Anthropic API key for Claude. Store in VS Code secret storage instead — use the 'Select AI Provider' command."
        },
        "aiNativeDevOps.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API key for GPT-4o/Codex. Store in VS Code secret storage instead — use the 'Select AI Provider' command."
        },
        "aiNativeDevOps.claudeModel": {
          "type": "string",
          "default": "claude-3-5-sonnet-20241022",
          "description": "Claude model to use"
        },
        "aiNativeDevOps.openaiModel": {
          "type": "string",
          "default": "gpt-4o",
          "description": "OpenAI model to use"
        },
        "aiNativeDevOps.currentPhase": {
          "type": "number",
          "minimum": 1,
          "maximum": 11,
          "default": 1,
          "description": "Current active lifecycle phase (1-11)"
        },
        "aiNativeDevOps.repoRoot": {
          "type": "string",
          "default": "",
          "description": "Path to the ai-native-devops repo containing docs/. Defaults to the first workspace folder."
        },
        "aiNativeDevOps.webhookQueueFile": {
          "type": "string",
          "default": ".ai-native-devops/events.jsonl",
          "description": "JSONL queue file consumed by the extension webhook processor."
        },
        "aiNativeDevOps.enableWebhookPolling": {
          "type": "boolean",
          "default": false,
          "description": "Enable periodic polling of webhook queue events on extension activation."
        },
        "aiNativeDevOps.webhookPollingSeconds": {
          "type": "number",
          "minimum": 10,
          "default": 30,
          "description": "Polling interval in seconds when webhook polling is enabled."
        },
        "aiNativeDevOps.autoOpenPanelOnWebhook": {
          "type": "boolean",
          "default": true,
          "description": "If true, the phase panel is opened while processing webhook events."
        }
      }
    },
    "menus": {
      "view/item/context": [
        {
          "command": "aiNativeDevOps.openPhase",
          "when": "view == aiNativeDevOps.lifecycle && viewItem == phase",
          "group": "inline@1"
        },
        {
          "command": "aiNativeDevOps.runPrompt",
          "when": "view == aiNativeDevOps.lifecycle && viewItem == phase",
          "group": "inline@2"
        },
        {
          "command": "aiNativeDevOps.openChecklist",
          "when": "view == aiNativeDevOps.lifecycle && viewItem == phase",
          "group": "inline@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "npx @vscode/vsce package",
    "start:webhook-bridge": "node scripts/webhook-bridge.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "openai": "^4.52.0"
  }
}
