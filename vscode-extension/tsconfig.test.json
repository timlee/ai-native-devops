{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "types": ["jest", "node"],
    "strict": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "test/unit/**/*.ts",
    "test/integration/**/*.ts",
    "test/__mocks__/**/*.ts",
    "test/fixtures/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "out",
    ".vscode-test",
    "test/e2e/**/*.ts"
  ]
}
